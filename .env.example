# =============================================================================
# ALTS Hostel Portal - Environment Configuration Template
# Anantha Lakshmi Institute of Technology & Sciences (Autonomous)
# Department of Computer Science and Engineering
# =============================================================================
# Copy this file to backend/.env before running the application:
#   copy .env.example backend\.env   (Windows)
#   cp .env.example backend/.env     (Linux/macOS)
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit your actual .env files with real credentials to version control.
# - The values below are safe placeholders for local development setup.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Backend Server Configuration (Node.js & Express)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# URL of the running frontend application for CORS authorization
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# 2. Database Connection (MongoDB)
# -----------------------------------------------------------------------------
# Local MongoDB connection or MongoDB Atlas connection string:
# Local Example:  mongodb://127.0.0.1:27017/alts_hostel_db
# Atlas Example:  mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/alts_hostel_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/alts_hostel_db

# -----------------------------------------------------------------------------
# 3. Authentication & JWT Security
# -----------------------------------------------------------------------------
# Secret key used for signing JSON Web Tokens (use a strong random 64+ char string in production)
JWT_SECRET=your_super_secret_jwt_key_placeholder_change_in_production_2026
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# 4. Facial Biometric Microservice (Python & OpenCV DNN)
# -----------------------------------------------------------------------------
# Base URL of the Python face recognition microservice (YuNet + SFace)
FACE_SERVICE_URL=http://127.0.0.1:5001
FACE_SERVICE_PORT=5001
FACE_SERVICE_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 5. Media & Profile Storage
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
