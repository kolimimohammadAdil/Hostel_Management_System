# =============================================================================
# HOSTELGUARD AI - Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env before starting the server locally:
#   cp .env.example .env (or copy .env.example .env on Windows)
#
# IMPORTANT:
# - Do NOT commit actual .env files containing credentials to version control.
# - MongoDB and JWT are placeholders for subsequent tasks (not connected yet).
# =============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS (Vite development default is http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Database Connection Placeholder (Unused in Foundation Phase)
# Example: mongodb://localhost:27017/hostelguard
MONGODB_URI=mongodb://localhost:27017/hostelguard_ai_placeholder

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_key_placeholder_change_in_production
JWT_EXPIRES_IN=7d

